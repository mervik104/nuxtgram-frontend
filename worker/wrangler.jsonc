{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nuxtgram-media-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  // Storage — Cloudflare R2, S3-совместимый API. S3_REGION должен быть 'auto',
  // S3_ENDPOINT — R2 S3 API-домен (<account_id>.r2.cloudflarestorage.com),
  // креды (S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY) — R2 API-токен, публичный
  // base-URL — r2.dev-subdomain или кастомный домен (см. docs/TODO-security.md).
  "vars": {
    "S3_ENDPOINT": "https://c173801bc8323d3335bf5068b2295a73.r2.cloudflarestorage.com",
    "S3_BUCKET_NAME": "nuxtgram",
    "S3_PUBLIC_BASE_URL": "https://pub-be720f2478a84a96a6397f76f38b4fa4.r2.dev",
    "S3_SIGNED_URL_TTL_SECONDS": "900",
    "S3_REGION": "auto",
    "MAX_UPLOAD_BYTES": "10485760",
    "CLERK_ISSUER": "https://clerk.mervik.ru",
    "CLERK_JWKS_URL": "https://clerk.mervik.ru/.well-known/jwks.json",
    "CLERK_AUDIENCE": "nuxtgram-surrealdb",
    "SURREALDB_URL": "wss://nuxtgram-databa-06g46rhocdvvd0fbbma22ik0fk.aws-use1.surreal.cloud/rpc",
    "SURREALDB_NAMESPACE": "main",
    "SURREALDB_DATABASE": "main",
    // TODO-SECURITY: заглушка. CORS сейчас открыт на все домены (ACAO: *)
    // намеренно для разработки/LAN-тестов. Перед прод-деплоем заменить на
    // боевой домен фронтенда и сузить CORS в src/index.ts (см. docs/TODO-security.md).
    "FRONTEND_ORIGIN": "http://localhost:3000"
  }
}